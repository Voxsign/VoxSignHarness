{
  "name": "example-shop",
  "type": "project",
  "scope": ["~/projects/example-shop/**"],
  "exclude": ["node_modules/**", ".env*", "**/secrets/**"],
  "tools": ["file", "git", "search", "test", "run", "read"],
  "context": ["project-map:example-shop"],
  "perms": {
    "read": true,
    "write": true,
    "exec": ["test", "run"]
  },
  "acceptance": "Sample project: text/content edits are confined to example-shop; order lookups are read-only.",
  "risk_default": "light",
  "cross_refs": ["vault-notes"],
  "version": 1
}
