# ===== secrets =====
.env
.env.*
*.env
!*.env.example
config/.env*

# ===== runtime artifacts (never publish user data) =====
# Note: cache/ and ground/ also contain source files (quad.go / ground.go and
# their tests); ignoring the whole directory would break a fresh clone
# (go build ./... reports "package not in std"). So we ignore only runtime
# outputs, never the source directories.
# data/ keeps only data/spaces/ (the sample space manifests); all other runtime
# data under data/ is regenerated locally.
/data/*
!/data/spaces/
/cache/*.json
/cache/*.jsonl
/ground/*.json
/ground/*.jsonl
/dist/
*.log

# ===== OS / editor =====
.DS_Store
*.swp
.idea/
.vscode/

# ===== Go =====
*.test
*.prof
coverage.out

# ===== local build artifacts (reproducible, not committed) =====
/bin/
