<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>VoxSign</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 麦克风 + 语音识别权限（真机授权；未授权自动回退键盘） -->
	<key>NSMicrophoneUsageDescription</key>
	<string>语音输入需要使用麦克风，将你说的话转成文字发给 Harness。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>语音识别用于把你的语音转成文字，可在发送前修改。</string>
	<!-- iOS 14+ 本地网络权限：真机访问局域网 Harness server（192.168.x.x）必弹此文案 -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>需要访问本地网络以连接同一 Wi-Fi 下的 VoxSign Harness server。</string>
	<!-- 真机连局域网 HTTP server（http://192.168.8.129:8897，M7 冒烟未走 TLS）。
	     用 NSAllowsLocalNetworking 精确放开 LAN（Wi-Fi/私网 IP），不全局放开任意加载。 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
